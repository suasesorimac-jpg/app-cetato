# ─── Cloudinary (AppCetato) ─────────────────────────────────────────────
# Copia este archivo a `.env` y completa tus credenciales.
# Vite expone únicamente las variables con prefijo VITE_.

# Tu Cloud Name (ej. "mi-nube") — panel de Cloudinary → Dashboard
VITE_CLOUDINARY_CLOUD_NAME=

# Upload preset UNSIGNED creado en Cloudinary → Settings → Upload → Upload presets
VITE_CLOUDINARY_UPLOAD_PRESET=appcetato_unsigned

# Compatibilidad con la convención de Create React App (opcional)
REACT_APP_CLOUDINARY_CLOUD_NAME=
REACT_APP_CLOUDINARY_UPLOAD_PRESET=appcetato_unsigned
